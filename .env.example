# Copy these into Vercel → Project → Settings → Environment Variables.

# Supabase (Project Settings → API). Safe to expose to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase SECRET key (API Keys → Secret keys, starts with sb_secret_). Server-only.
# Powers slip verification and result settling. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Live data comes from ESPN's public feeds. No key needed.

# Screenshot scanning — set ONE of these. Server-only.
# Free: Google Gemini key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=
# Paid: Anthropic key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: swap the model (default claude-haiku-5-5)
ANTHROPIC_MODEL=
