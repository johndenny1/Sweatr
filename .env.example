# Copy these into Vercel → Project → Settings → Environment Variables.

# Supabase (Project Settings → API). Safe to expose to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SportsDataIO. Server-only — never prefix these with VITE_.
# If one key covers every league, set only SPORTSDATA_API_KEY.
# If SportsDataIO gave you a separate key per league, set those instead.
SPORTSDATA_API_KEY=
SPORTSDATA_KEY_NFL=
SPORTSDATA_KEY_NBA=
SPORTSDATA_KEY_MLB=
SPORTSDATA_KEY_CFB=
SPORTSDATA_KEY_CBB=
